<UserControl x:Class="HUCE_DALTUDXD_68TH1_0298968.View.UC_Ribbon.UC_Ribbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HUCE_DALTUDXD_68TH1_0298968.View.UC_Ribbon"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Ribbon SelectionChanged="Ribbon_SelectionChanged">
            <RibbonTab Header="Dữ liệu thiết kế">
                <RibbonGroup Header="Etabs API">

                    <RibbonButton LargeImageSource="/Assets/Icons/DuLieuEtabs.png" Label="Kết nối Etabs" 
                          x:Name="rbt_KetNoiEtabs"   
                                  Click="rbt_KetNoiEtabstabs_Click">
                    </RibbonButton>




                    <RibbonRadioButton x:Name="rbt_2Dplan"
                        SmallImageSource="/Assets/Icons/MatBangCacTang.png" Label="Mặt bằng 2D">

                    </RibbonRadioButton>
                    <RibbonCheckBox Label="Lấy dữ liệu tự dộng"/>
                    <RibbonComboBox Label="Chọn loại kết cấu" SmallImageSource="/Assets/Icons/MatBangCacTang.png">
                        
                    
                    <RibbonGallery>
                        <RibbonGalleryCategory>
                            <RibbonGalleryItem Content="kết cấu thép"/>
                        </RibbonGalleryCategory>
                    </RibbonGallery>
                    </RibbonComboBox>
                </RibbonGroup>
                <RibbonGroup Header="">
                    
                </RibbonGroup>
            </RibbonTab>
     
        </Ribbon>
    </Grid>
</UserControl>

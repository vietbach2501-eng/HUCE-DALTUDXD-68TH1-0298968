<Page x:Class="HUCE_DALTUDXD_68TH1_0298968.Views.Plan2DPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HUCE_DALTUDXD_68TH1_0298968.Views"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="1000"
      Title="Plan2DPage">
    <Grid x:Name="GridA" ShowGridLines="True">
        <!--khai báo bố cục chính-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="700"/>
           
        </Grid.RowDefinitions>
        <!--1. Nhập liệu dầm-->
        <Grid x:Name="GridA1" ShowGridLines="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="350"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
          

            <GroupBox Header="Vật liệu" Grid.Row="1">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="5"  >
                        <Label Content="Mác thép:"/>
                        <ComboBox x:Name="cmb_macthep" 
                             ItemsSource="{Binding Path=ConcreteMaterialList}"
                             DisplayMemberPath="Name"
                             SelectedItem="{Binding ConcreteMaterial}"
                             Width="80" 
                           Margin="5 0 0 0" SelectedIndex="1" >
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </GroupBox>


            <GroupBox Header="Đặc trưng hình học tiết diện" Grid.Row="0">
                <StackPanel Orientation="Vertical">

                    <StackPanel Orientation="Horizontal" Margin="5" >
                        <Label Content="A:" />
                        <TextBlock x:Name="tbtA"
                 Text="{Binding A}"
                 Width="100" Margin="35 0 0 0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5" >
                        <Label Content="Ix:" />
                        <TextBlock x:Name="tbt_Ix"
                 Text="{Binding Ix}"
                 Width="100" Margin="35 0 0 0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5" >
                        <Label Content="Iy:" />
                        <TextBlock x:Name="tbt_Iy"
                    Text="{Binding Iy}"
                     Width="100" Margin="35 0 0 0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5" >
                        <Label Content="Wx:" />
                        <TextBlock x:Name="tbt_Wx"
                        Text="{Binding Wx}"
                        Width="100" Margin="35 0 0 0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5" >
                        <Label Content="Sx:" />
                        <TextBlock x:Name="tbt_Sx"
                    Text="{Binding Sx}"
                     Width="100" Margin="35 0 0 0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5" >
                        <Label Content="Sf:" />
                        <TextBlock x:Name="tbt_Sf"
                          Text="{Binding Sf}"
                         Width="100" Margin="35 0 0 0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5" >
                        <Label Content="rx:" />
                        <TextBlock x:Name="tbt_rx"
                     Text="{Binding rx}"
                      Width="100" Margin="35 0 0 0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5" >
                        <Label Content="ry:" />
                        <TextBlock x:Name="tbt_ry"
                      Text="{Binding ry}"
                      Width="100" Margin="35 0 0 0"/>
                    </StackPanel>
                </StackPanel>

            </GroupBox>
        </Grid>

        <!--2. Danh sách quản lý dầm-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="450"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="dtg_BeamList" Grid.Column="2" Grid.Row="0"  ItemsSource="{Binding BeamList, IsAsync=True}" 
              SelectedItem="{Binding CurrentBeam, Mode=TwoWay}"
              AutoGenerateColumns="False" 
              CanUserAddRows="False" Margin="10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã hiệu" Binding="{Binding Mark}"/>
                    <DataGridTextColumn Header="Lx"  Binding="{Binding Lx}"/>
                    <DataGridTextColumn Header="Ly"  Binding="{Binding Ly}"/>
                    <DataGridTextColumn Header="h"  Binding="{Binding h}"/>
                    <DataGridTextColumn Header="bf"  Binding="{Binding bf}"/>
                    <DataGridTextColumn Header="tf"  Binding="{Binding tf}"/>
                    <DataGridTextColumn Header="hw" Binding="{Binding hw}"/>
                    <DataGridTextColumn Header="tw" Binding="{Binding tw}"/>
                    <DataGridTextColumn Header="M"  Binding="{Binding M}"/>
                    <DataGridTextColumn Header="Q"  Binding="{Binding Q}"/>
                    <DataGridTextColumn Header="σ₁ (kN/cm2)"  Binding="{Binding xichma}"/>
                    <DataGridTextColumn Header="τ₁ (kN/cm2)"  Binding="{Binding to}"/>
                    <DataGridTextColumn Header="σ_td (kN/cm2)"  Binding="{Binding ungsuat_td}"/>
                    <DataGridTextColumn Header="Kiểm tra bền"  Binding="{Binding KiemTraBen}"/>
                    <DataGridTextColumn Header="Kiểm tra bền ổn định tổng thể"  Binding="{Binding KiemTraBenTT}"/>
                    <DataGridTextColumn Header="Kiểm tra bền cục bộ "  Binding="{Binding KiemTraBenCB}"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>

                            <DataTrigger Binding="{Binding BaiToan}" Value="Không đạt" >
                                <Setter Property="Background" Value="Yellow"/>
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>



            </DataGrid>

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnThemDam" Command="{Binding AddBeamCommand}" Content="Thêm dầm" Width="100"  Height="30"  />
                <Button x:Name="btnXoaDam" Command="{Binding RemoveBeamCommand}" Content="Xóa dầm" Width="100"  Height="30"  Margin="50 0 0 0" />
                
            </StackPanel>
           
        </Grid>
    </Grid>


</Page>

<UserControl x:Class="HUCE_DALTUDXD_68TH1_0298968.Views.UserControls.UC_Ribbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HUCE_DALTUDXD_68TH1_0298968.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="800">
    <Grid>
        <Ribbon>
            <RibbonTab Header="Tính toán">
                <RibbonGroup Header=" Vật liệu ">
                    <RibbonButton Label="Hệ số"
                                x:Name="btn_Material"
                                  Click="btn_Material_Click"    
                      LargeImageSource="/Assets/Icons/paper (1).png"/>
                </RibbonGroup>

                <RibbonGroup Header="Tính Toán "  >
                    <RibbonButton Label="Kiểm TRa"
                                  x:Name="rbt_2Dplan"
                                  Click="rbt_2Dplan_Click"
                LargeImageSource="/Assets/Icons/beam.png" />
                </RibbonGroup>

                <RibbonGroup Header="Thông số " >
                    <RibbonButton Label="Tiết diện I"
                       x:Name="btn_heso"
                       Click="btn_heso_Click"
             LargeImageSource="/Assets/Icons/check.png" />
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>
    </Grid>
</UserControl>
